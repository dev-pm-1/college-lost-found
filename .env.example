# College Lost & Found Portal - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="College Lost & Found Portal"
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=generate_a_secure_random_secret_key_for_production_use_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional College Email Restriction (e.g. college.edu; leave empty to allow any domain)
ALLOWED_EMAIL_DOMAIN=

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lostfound
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lostfound

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
